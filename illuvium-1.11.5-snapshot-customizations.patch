+		if (const FWorldContext* WorldContext = GameInstance->GetWorldContext())
+		{
+			return WorldContext->PIEInstance == INDEX_NONE ? 0 : WorldContext->PIEInstance;
+		}
+	}
+#endif
+	return 0;
+}
